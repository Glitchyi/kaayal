# Non-secret template. DO NOT commit real tokens.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SARVAM_TOOL_SHARED_SECRET=
KAAYAL_PUBLIC_BASE_URL=https://your-tunnel.example
PORT=8000
OPENAI_TIMEOUT_SECONDS=12
OPENAI_MAX_OUTPUT_TOKENS=180
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///kaayal.db
# Owner admin token for /admin?t=... (Phase 2). Operators use unique portal URLs.
ADMIN_TOKEN=
KAAYAL_PHONE_NUMBER=
KAAYAL_WHATSAPP_NUMBER=
# wa-bot /send listener for push notifications (compose sets this internally;
# only needed for a native wa-bot). Unset = no WhatsApp push on approval.
WA_BOT_URL=
# Demo controls (optional)
SIM_CALLBACK_OUTCOME=interested
DEMO_IGNORE_CALL_WINDOW=false
CALLBACK_TICK_SECONDS=30

# Sarvam Instant Outbound — real calls (owner-approved; charges apply).
# Set OUTBOUND_PROVIDER=sarvam to enable; leave unset for the simulator.
OUTBOUND_PROVIDER=simulator
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_OUTBOUND_APP_ID=
SARVAM_OUTBOUND_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_OUTBOUND_TIMEOUT_SECONDS=300
